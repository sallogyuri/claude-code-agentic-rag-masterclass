# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>

# OpenAI (used for embeddings: text-embedding-3-small)
OPENAI_API_KEY=<openai-api-key>

# LLM Provider (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=<your-openrouter-api-key>
LLM_MODEL=openai/gpt-4o-mini
LLM_SYSTEM_PROMPT=You are a helpful assistant. Use the retrieve_chunks tool to search uploaded documents when relevant.

# LangSmith
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_PROJECT=rag-masterclass-module2
LANGSMITH_TRACING_V2=true

# App
ALLOWED_ORIGINS=http://localhost:5173
